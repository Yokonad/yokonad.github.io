  <script is:inline>
    (function () {
      var clock = document.getElementById('codex-clock');
      if (clock) {
        var pad = function (n) { return String(n).padStart(2, '0'); };
        var tick = function () {
          var d = new Date();
          clock.textContent = pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
        };
        tick();
        setInterval(tick, 1000);
      }

      var CH = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
      function scramble(el) {
        var target = el.getAttribute('data-text');
        if (target === null) { target = el.textContent; el.setAttribute('data-text', target); }
        var q = [];
        for (var i = 0; i < target.length; i++) {
          q.push({ c: target[i], to: 8 + Math.floor(Math.random() * 26) });
        }
        var frame = 0;
        function update() {
          var out = '', done = 0;
          for (var i = 0; i < q.length; i++) {
            if (frame >= q[i].to) { out += q[i].c; done++; }
            else if (q[i].c === ' ') { out += ' '; done++; }
            else {
              if (!q[i].r || Math.random() < 0.3) q[i].r = CH[Math.floor(Math.random() * CH.length)];
              out += '<span class="scr-dim">' + q[i].r + '</span>';
            }
          }
          el.innerHTML = out;
          if (done === q.length) { el.textContent = target; return; }
          frame++;
          requestAnimationFrame(update);
        }
        update();
      }

      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var titles = document.querySelectorAll('.scramble');
      var rises = document.querySelectorAll('.rise');

      if (reduce || !('IntersectionObserver' in window)) {
        rises.forEach(function (el) { el.classList.add('in'); });
        return;
      }

      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          if (e.target.classList.contains('scramble')) scramble(e.target);
          if (e.target.classList.contains('rise')) e.target.classList.add('in');
          io.unobserve(e.target);
        });
      }, { threshold: 0.25 });

      titles.forEach(function (el) { io.observe(el); });
      rises.forEach(function (el) { io.observe(el); });
    })();

    // ── Calendario de contribuciones de GitHub ──
    (function () {
      var cal = document.getElementById('gh-cal');
      var totalEl = document.getElementById('gh-total');
      if (!cal) return;
      var LEVELS = ['rgba(244,244,245,0.10)', '#9be9a8', '#40c463', '#30a14e', '#216e39'];
      fetch('https://github-contributions-api.jogruber.de/v4/Yokonad?y=last')
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var c = data.contributions || [];
          if (!c.length) { cal.innerHTML = '<div class="text-[11px] py-6 text-center text-[var(--ink-soft)]">Sin datos</div>'; return; }
          var weeks = [], cur = [];
          var startDay = new Date(c[0].date).getDay();
          for (var i = 0; i < startDay; i++) cur.push(null);
          c.forEach(function (d) { cur.push(d); if (cur.length === 7) { weeks.push(cur); cur = []; } });
          if (cur.length) { while (cur.length < 7) cur.push(null); weeks.push(cur); }

          var wrap = document.createElement('div');
          wrap.className = 'gh-grid';
          var grid = [];
          weeks.forEach(function (w) {
            var col = document.createElement('div');
            col.className = 'gh-week';
            var colCells = [];
            w.forEach(function (d) {
              var level = d ? (d.level || 0) : 0;
              var cell = document.createElement('span');
              cell.className = 'gh-cell';
              cell.style.background = LEVELS[level];
              if (d) cell.title = d.date + ': ' + d.count;
              col.appendChild(cell);
              colCells.push({ el: cell, level: level });
            });
            wrap.appendChild(col);
            grid.push(colCells);
          });
          cal.innerHTML = '';
          cal.appendChild(wrap);
          if (totalEl) totalEl.textContent = ((data.total && data.total.lastYear) || c.length) + ' contribuciones';

          var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var desktop = window.matchMedia && window.matchMedia('(min-width: 641px)').matches;
          if (!reduce && desktop) startSnake(grid, LEVELS);
        })
        .catch(function () { cal.innerHTML = '<div class="text-[11px] py-6 text-center text-[var(--ink-soft)]">No se pudieron cargar</div>'; });

      // ── Snake que recorre y "come" las contribuciones (auto, en bucle) ──
      function startSnake(grid, LEVELS) {
        var cols = grid.length, rows = 7;
        var path = [];
        for (var c = 0; c < cols; c++) {
          if (c % 2 === 0) { for (var r = 0; r < rows; r++) path.push([c, r]); }
          else { for (var r2 = rows - 1; r2 >= 0; r2--) path.push([c, r2]); }
        }
        var BODY = 7;
        var SNAKE = '#c8c8d2';
        var HEAD = '#f4f4f5';
        var eaten = {};
        var i = 0;

        function origBg(p) {
          return eaten[p[0] * 100 + p[1]] ? LEVELS[0] : LEVELS[grid[p[0]][p[1]].level];
        }
        function color(p, bg) {
          var cell = grid[p[0]] && grid[p[0]][p[1]];
          if (cell) cell.el.style.background = bg;
        }
        function step() {
          if (i < path.length) {
            var p = path[i];
            if (grid[p[0]][p[1]].level > 0) eaten[p[0] * 100 + p[1]] = true;
            color(p, HEAD);
            if (i - 1 >= 0) color(path[i - 1], SNAKE);
            var tail = i - BODY;
            if (tail >= 0) color(path[tail], origBg(path[tail]));
            i++;
            setTimeout(step, 45);
          } else {
            for (var b = 1; b <= BODY; b++) { var t = i - b; if (t >= 0) color(path[t], origBg(path[t])); }
            setTimeout(function () {
              eaten = {};
              for (var cc = 0; cc < cols; cc++) for (var rr = 0; rr < rows; rr++) color([cc, rr], LEVELS[grid[cc][rr].level]);
              i = 0;
              step();
            }, 2200);
          }
        }
        step();
      }
    })();

    // ── Contador de ciberataques en vivo ──
    (function () {
      var el = document.getElementById('cyber-count');
      if (!el) return;
      var BASE = Date.UTC(2026, 0, 1) / 1000;
      var RATE = 2200;
      function up() { el.textContent = Math.floor((Date.now() / 1000 - BASE) * RATE).toLocaleString('en-US'); }
      up();
      setInterval(up, 80);
    })();

    // ── Tiempo sin nuevo capítulo (Go-Tōbun no Hanayome) ──
    (function () {
      var el = document.getElementById('quint');
      if (!el) return;
      var L = new Date('2020-02-19T00:00:00Z');
      var labels = ['años', 'meses', 'días', 'hrs', 'min', 'seg'];
      function pad(n) { return String(n).padStart(2, '0'); }
      function up() {
        var now = new Date();
        var Y = now.getFullYear() - L.getFullYear();
        var Mo = now.getMonth() - L.getMonth();
        var D = now.getDate() - L.getDate();
        var H = now.getHours() - L.getHours();
        var Mi = now.getMinutes() - L.getMinutes();
        var S = now.getSeconds() - L.getSeconds();
        if (S < 0) { S += 60; Mi--; }
        if (Mi < 0) { Mi += 60; H--; }
        if (H < 0) { H += 24; D--; }
        if (D < 0) { D += new Date(now.getFullYear(), now.getMonth(), 0).getDate(); Mo--; }
        if (Mo < 0) { Mo += 12; Y--; }
        var vals = [Y, Mo, D, pad(H), pad(Mi), pad(S)];
        var html = '';
        for (var i = 0; i < 6; i++) {
          html += '<div class="text-center"><span class="block text-base sm:text-lg font-bold leading-none">' + vals[i] + '</span><span class="text-[7px] uppercase tracking-widest text-[var(--ink-soft)]">' + labels[i] + '</span></div>';
          if (i < 5) html += '<span class="text-sm leading-none">:</span>';
        }
        el.innerHTML = html;
      }
      up();
      setInterval(up, 1000);
    })();

    // ── Último partido del FC Barcelona ──
    (function () {
      var box = document.getElementById('barca');
      if (!box) return;
      fetch('https://www.thesportsdb.com/api/v1/json/3/eventslast.php?id=133739')
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var m = data.results && data.results[0];
          if (!m) { box.innerHTML = '<span class="text-[11px] text-[var(--ink-soft)]">Sin datos</span>'; return; }
          var badge = function (url) { return url ? '<img src="' + url + '" alt="" class="w-8 h-8 object-contain"/>' : ''; };
          box.innerHTML =
            '<div class="flex items-center gap-3 my-1">' +
            '<div class="flex flex-col items-center gap-1">' + badge(m.strHomeTeamBadge) + '<span class="text-[9px] uppercase tracking-widest font-bold">' + m.strHomeTeam + '</span></div>' +
            '<div class="flex items-center gap-2"><span class="text-2xl font-bold text-[var(--violet-deep)]">' + (m.intHomeScore || 0) + '</span><span class="text-lg">-</span><span class="text-2xl font-bold text-[var(--violet-deep)]">' + (m.intAwayScore || 0) + '</span></div>' +
            '<div class="flex flex-col items-center gap-1">' + badge(m.strAwayTeamBadge) + '<span class="text-[9px] uppercase tracking-widest font-bold">' + m.strAwayTeam + '</span></div>' +
            '</div>' +
            '<span class="text-[8px] text-[var(--ink-soft)]">' + (m.strVenue || '') + ' — ' + (m.strStatus || 'FT') + '</span>';
        })
        .catch(function () { box.innerHTML = '<span class="text-[11px] text-[var(--ink-soft)]">Sin datos</span>'; });
    })();

    // ── Cita: frases reflexivas que rotan con scramble (en bucle) ──
    (function () {
      var el = document.getElementById('cita-frase');
      if (!el) return;
      var phrases = [
        'ENTENDER ES MÁS FUERTE QUE TEMER.',
        'LAS REDES CONECTAN MÁS QUE MÁQUINAS.',
        'CADA ERROR ES UNA LÍNEA HACIA LA SOLUCIÓN.',
        'EL CÓDIGO ABIERTO CONSTRUYE COMUNIDAD.',
        'EL CONOCIMIENTO SE COMPARTE, NO SE ACAPARA.'
      ];
      var CH = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
      var HOLD = 4000; // ms que se mantiene cada frase
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var idx = 0;

      function scrambleTo(text, cb) {
        if (reduce) { el.textContent = text; if (cb) setTimeout(cb, HOLD); return; }
        var q = [];
        for (var i = 0; i < text.length; i++) {
          q.push({ c: text[i], to: 6 + Math.floor(Math.random() * 22) });
        }
        var frame = 0;
        function update() {
          var out = '', done = 0;
          for (var i = 0; i < q.length; i++) {
            if (frame >= q[i].to) { out += q[i].c; done++; }
            else if (q[i].c === ' ') { out += ' '; done++; }
            else {
              if (!q[i].r || Math.random() < 0.3) q[i].r = CH[Math.floor(Math.random() * CH.length)];
              out += '<span class="scr-dim">' + q[i].r + '</span>';
            }
          }
          el.innerHTML = out;
          if (done === q.length) { el.textContent = text; if (cb) cb(); return; }
          frame++;
          requestAnimationFrame(update);
        }
        update();
      }

      function cycle() {
        scrambleTo(phrases[idx], function () {
          setTimeout(function () {
            idx = (idx + 1) % phrases.length;
            cycle();
          }, HOLD);
        });
      }
      cycle();
    })();

    // ── Música: randomiza canciones + playlist que rueda hacia arriba ──
    (function () {
      function shuffle(a) {
        for (var i = a.length - 1; i > 0; i--) {
          var j = Math.floor(Math.random() * (i + 1));
          var t = a[i]; a[i] = a[j]; a[j] = t;
        }
        return a;
      }

      // Randomizar qué álbum aparece en cada posición de la órbita
      var orbitImgs = [].slice.call(document.querySelectorAll('.orbit-item img'));
      var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (orbitImgs.length > 1) {
        var srcs = orbitImgs.map(function (im) { return im.getAttribute('src'); });
        shuffle(srcs);
        orbitImgs.forEach(function (im, i) { im.setAttribute('src', srcs[i]); });

        // Las carátulas van cambiando mientras orbitan (intercambio con fundido)
        if (!reduceMotion) {
          setInterval(function () {
            // Rota todas las carátulas una posición (cada slot va pasando por todos los álbumes)
            srcs.unshift(srcs.pop());
            orbitImgs.forEach(function (im, i) {
              setTimeout(function () {
                im.style.opacity = '0';
                setTimeout(function () {
                  im.setAttribute('src', srcs[i]);
                  im.style.opacity = '';
                }, 200);
              }, i * 70);
            });
          }, 7000);
        }
      }

      var ul = document.getElementById('playlist');
      if (!ul) return;
      var viewport = ul.parentElement;
      var rows = [].slice.call(ul.querySelectorAll('.pl-row'));
      if (rows.length < 2) return;

      // Randomizar el orden de la playlist
      shuffle(rows);
      rows.forEach(function (li) { ul.appendChild(li); });

      // Mostrar solo algunas filas (las ocultas entran al rodar → sin duplicados)
      var rowH = ul.querySelector('.pl-row').getBoundingClientRect().height;
      var VISIBLE = Math.min(5, rows.length);
      viewport.style.height = Math.round(rowH * VISIBLE) + 'px';

      function highlightTop() {
        var rs = ul.querySelectorAll('.pl-row');
        for (var i = 0; i < rs.length; i++) rs[i].classList.toggle('pl-active', i === 0);
      }
      highlightTop();

      var animating = false;
      function advance() {
        if (animating) return;
        var first = ul.querySelector('.pl-row');
        if (!first) return;
        animating = true;
        var h = first.getBoundingClientRect().height;
        ul.style.transition = 'transform 0.55s ease';
        ul.style.transform = 'translateY(-' + h + 'px)';
        function done(e) {
          if (e.target !== ul || e.propertyName !== 'transform') return;
          ul.removeEventListener('transitionend', done);
          ul.style.transition = 'none';
          first.classList.remove('pl-active');
          ul.appendChild(first);
          ul.style.transform = 'translateY(0)';
          void ul.offsetHeight;
          highlightTop();
          animating = false;
        }
        ul.addEventListener('transitionend', done);
      }
      setInterval(advance, 8820);
    })();

    // ── Escalado responsive del orbit de álbumes ──
    (function () {
      var box = document.querySelector('.orbit-scale');
      if (!box) return;
      var BASE = 760;
      var cont = box.parentElement;
      function upd() { box.style.transform = 'scale(' + cont.clientWidth / BASE + ')'; }
      upd();
      if (window.ResizeObserver) new ResizeObserver(upd).observe(cont);
      else window.addEventListener('resize', upd);
    })();

    // ── Hero: alterna "Terminal" ↔ "Cama" con scramble (sin mover el layout) ──
    (function () {
      var l3 = document.getElementById('hero-l3');
      if (!l3) return;
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var CH = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
      var words = ['Terminal', 'Cama'];
      var idx = 0;

      function scrambleWord(el, text) {
        if (reduce) { el.textContent = text; return; }
        var q = [];
        for (var i = 0; i < text.length; i++) q.push({ c: text[i], to: 4 + Math.floor(Math.random() * 16) });
        var frame = 0;
        function update() {
          var out = '', done = 0;
          for (var i = 0; i < q.length; i++) {
            if (frame >= q[i].to) { out += q[i].c; done++; }
            else {
              if (!q[i].r || Math.random() < 0.3) q[i].r = CH[Math.floor(Math.random() * CH.length)];
              out += '<span class="scr-dim">' + q[i].r + '</span>';
            }
          }
          el.innerHTML = out;
          if (done === q.length) { el.textContent = text; return; }
          frame++;
          requestAnimationFrame(update);
        }
        update();
      }

      setInterval(function () {
        idx = (idx + 1) % words.length;
        scrambleWord(l3, words[idx]);
      }, 5000);
    })();
  </script>
</Layout>
