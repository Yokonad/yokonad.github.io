---
import Layout from '../layouts/Layout.astro';
import PixelBlast from '../components/PixelBlast.astro';
import { profile, projects, team, teamName, teamDescription, comunidad } from '../data/content.js';

const stack = [
  'Redes y subneteo — Cisco Packet Tracer',
  'Desarrollo web — React, Node.js',
  'Scripting y automatización — Python',
  'Sistemas — Windows, Arch, Fedora, Debian',
  'Ciberseguridad defensiva',
  'Proyectos open-source',
];

// Logos del carrusel (Simple Icons CDN). Sin slug => se muestra como texto.
const techLogos = [
  { slug: 'javascript', title: 'JavaScript' },
  { slug: 'react', title: 'React' },
  { slug: 'nodedotjs', title: 'Node.js' },
  { slug: 'python', title: 'Python' },
  { slug: 'css', title: 'CSS' },
  { slug: 'git', title: 'Git' },
  { slug: 'openjdk', title: 'Java' },
  { slug: 'tailwindcss', title: 'Tailwind' },
  { slug: 'html5', title: 'HTML' },
  { slug: 'linux', title: 'Linux' },
  { slug: 'archlinux', title: 'Arch' },
  { slug: 'ubuntu', title: 'Ubuntu' },
  { slug: 'go', title: 'Go' },
  { slug: 'npm', title: 'npm' },
  { slug: 'claude', title: 'Claude' },
  { slug: 'deepseek', title: 'DeepSeek' },
];

// Reproductor de música — playlist (8 canciones)
const tracks = [
  { id: 'eJLwj6FohJo', title: 'Indiana', artist: 'Hombres G' },
  { id: 'URoY2H7VhBI', title: 'Parte del Aire', artist: 'Fito Páez' },
  { id: '6hzrDeceEKc', title: 'Wonderwall', artist: 'Oasis' },
  { id: 'tI-5uv4wryI', title: 'Champagne Supernova', artist: 'Oasis' },
  { id: 'xg_Y7Or_hWM', title: 'Last Night on Earth', artist: 'Green Day' },
  { id: 'Qy7LcH7pWZo', title: 'Díganselo', artist: 'El Kuelgue' },
  { id: 'MVeiKDh4ffk', title: 'Cada Vez Que Digo Adiós', artist: 'Los Enanitos Verdes' },
  { id: 'ZjZecW1BvZE', title: 'Mi Primer Día Sin Ti', artist: 'Los Enanitos Verdes' },
];

// Colores por marca para las tarjetas de contacto
const linkConfig = {
  GitHub: {
    icon: '#17141f',
    bar: 'background:#17141f',
    path: 'M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z',
  },
  Instagram: {
    icon: '#E1306C',
    bar: 'background:linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888)',
    path: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z',
  },
  Discord: {
    icon: '#5865F2',
    bar: 'background:#5865F2',
    path: 'M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.095 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.095 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z',
  },
  Email: {
    icon: '#17141f',
    bar: 'background:#4d6bf2',
    path: 'M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z',
  },
};

// Colores por lenguaje/etiqueta del equipo (ajustados para fondo claro)
const tagColors = {
  Python: { border: '#3776AB', bg: 'rgba(55,118,171,0.12)', text: '#2f6fb0' },
  Android: { border: '#3DDC84', bg: 'rgba(61,220,132,0.14)', text: '#1f9d57' },
  Streaming: { border: '#9146FF', bg: 'rgba(145,70,255,0.12)', text: '#7a3fd6' },
  Frontend: { border: '#F97316', bg: 'rgba(249,115,22,0.12)', text: '#d65f0a' },
  'UI/UX': { border: '#EC4899', bg: 'rgba(236,72,153,0.12)', text: '#d62e84' },
  Cisco: { border: '#1BA0D7', bg: 'rgba(27,160,215,0.12)', text: '#1487b8' },
  HTML: { border: '#E34F26', bg: 'rgba(227,79,38,0.12)', text: '#d1431d' },
  JavaScript: { border: '#caa900', bg: 'rgba(247,223,30,0.20)', text: '#8f7a00' },
};

const tagStyle = (t) => {
  const c = tagColors[t];
  return c
    ? `border:1px solid ${c.border};background:${c.bg};color:${c.text}`
    : 'border:1px solid var(--ink-soft);color:var(--ink-soft)';
};
---

<Layout>
  <PixelBlast
    variant="circle"
    color="#3a3a48"
    pixelSize={6}
    patternScale={3}
    patternDensity={1.45}
    pixelSizeJitter={0.5}
    rippleSpeed={0.4}
    rippleThickness={0.12}
    rippleIntensityScale={1.5}
    speed={0.6}
    edgeFade={0.25}
  />

  <div id="top" class="codex-edges codex-stack w-full py-4 sm:py-6 relative z-10">
    <!-- ═══════════ MASTHEAD ═══════════ -->
    <header class="flex items-center justify-between border-2 border-[var(--ink)] bg-[var(--violet)] px-3 py-2 text-[var(--cream)]">
      <span class="text-[9px] sm:text-[12px] font-bold tracking-[0.14em] uppercase">
        YOKONAD // ISSUE 001 // 2026
      </span>
      <span class="flex items-center gap-2 sm:gap-3 text-[9px] sm:text-[12px] font-bold tracking-[0.14em] uppercase">
        <span id="codex-clock" class="hidden sm:inline tabular-nums">--:--:--</span>
        <span class="normal-case">yokonad.dev</span>
        <span class="win-btns"><i></i><i></i><i></i></span>
      </span>
    </header>

    <!-- ═══════════ 1 · TÍTULO ═══════════ -->
    <section>
      <p class="text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.3em] text-[var(--ink)] mb-3">
        ◆ Editorial · Carta del autor
      </p>
      <div class="flex flex-col lg:flex-row lg:items-end gap-5 lg:gap-8">
        <div class="lg:flex-1 min-w-0 lg:self-start">
          <h1 class="display uppercase leading-[0.84]" style="text-shadow:4px 4px 0 #52525b">
            <span class="scramble block text-[clamp(2.6rem,11vw,5.6rem)]">Desde</span>
            <span class="scramble block text-[clamp(2.6rem,11vw,5.6rem)]">Mi</span>
            <span id="hero-l3" class="scramble block text-[clamp(2.6rem,11vw,5.6rem)]">Terminal</span>
          </h1>
          <p class="mt-4 text-[13px] sm:text-[14px] leading-relaxed max-w-2xl">
            Ciberseguridad, redes y código desde Perú. Un recorrido por proyectos y la comunidad que
            construyo en el camino. Entre terminales, Linux y buena música, documento lo que aprendo y
            comparto cada paso del proceso.
          </p>
        </div>
        <img
          src="/picture/slash-titulo.webp"
          alt="Yokonad"
          loading="eager"
          class="w-full max-w-[420px] sm:max-w-lg lg:max-w-none lg:w-[48%] object-contain self-center lg:self-end shrink-0"
        />
      </div>
    </section>

    <!-- ═══════════ 2 · PERFIL ═══════════ -->
    <section class="space-y-4">
      <div class="section-label">// Perfil</div>

      <!-- Presentación con avatar -->
      <div class="win rise">
        <div class="win-bar is-ink">
          <span class="scramble">YOKONAD_PROFILE</span>
          <span class="win-btns"><i></i><i></i><i></i></span>
        </div>
        <div class="p-4 sm:p-5 grid gap-5 sm:grid-cols-[auto_1fr] items-start">
          <!-- Avatar grande -->
          <div class="relative mx-auto sm:mx-0 shrink-0">
            <img
              src={profile.avatar}
              alt="Yokonad"
              loading="eager"
              class="w-44 h-52 sm:w-48 sm:h-60 object-cover border-2 border-[var(--ink)]"
              style="box-shadow:6px 6px 0 rgba(244,244,245,0.28)"
            />
            <span class="absolute -bottom-2.5 left-2 inline-flex items-center gap-1.5 bg-[#0c0c0e] border border-[var(--ink)] text-[var(--cream)] text-[9px] uppercase tracking-widest px-2 py-1">
              <span class="w-1.5 h-1.5 rounded-full bg-[#3fb950]" style="box-shadow:0 0 6px #3fb950"></span>
              Disponible
            </span>
          </div>

          <!-- Info -->
          <div class="min-w-0">
            <p class="display text-3xl sm:text-4xl text-[var(--ink)] lowercase leading-none">yokonad<span class="cursor-blink"></span></p>
            <p class="text-[11px] uppercase tracking-[0.2em] text-[var(--ink-soft)] mt-2.5">Dan Ramos Reynaldo</p>
            <p class="text-[12px] mt-0.5">Estudiante de Ciberseguridad</p>
            <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-[10px] text-[var(--ink-soft)]">
              <span>◈ {profile.location}</span>
              <span>◈ SENATI · 6.º ciclo</span>
              <span>◈ Redes · Linux · Web</span>
            </div>
            <p class="mt-3 text-[12.5px] leading-relaxed">
              Apasionado por las redes, Linux y el código. Lo que empezó como curiosidad por entender cómo
              funcionan las máquinas se convirtió en proyectos y una comunidad.
            </p>

            <!-- Ficha de datos -->
            <div class="mt-4 border-t-2 border-dashed border-[rgba(244,244,245,0.25)] pt-3 grid grid-cols-1 sm:grid-cols-2 gap-x-5 gap-y-1.5">
              {
                [
                  ['Apodo', 'yokonad'],
                  ['Ubicación', 'Perú'],
                  ['Estudios', 'Ciberseguridad · SENATI'],
                  ['Ciclo', '6.º — en curso'],
                  ['Enfoque', 'Redes & Linux'],
                  ['Intereses', 'Anime · Música'],
                  ['Combustible', 'Código & café'],
                  ['Estado', 'Disponible'],
                ].map(([k, v]) => (
                  <div class="flex gap-2 text-[11px]">
                    <span class="text-[var(--ink-soft)] uppercase tracking-widest text-[9px] w-24 shrink-0 pt-px">{k}</span>
                    <span class="flex-1 font-medium">{v}</span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <!-- Sobre mí + Stack -->
      <div class="grid gap-4 md:grid-cols-2">
        <div class="win rise">
          <div class="win-bar"><span class="scramble">Sobre mí</span></div>
          <div class="p-3 text-[12px] leading-relaxed">
            <p class="mb-2.5">Este portafolio existe como un espacio para aprender, construir y compartir.</p>
            <ul class="space-y-1.5">
              <li class="diamond">Estudiante de Ciberseguridad — SENATI</li>
              <li class="diamond">Redes, Linux y desarrollo web</li>
              <li class="diamond">La música como combustible diario</li>
            </ul>
            <p class="mt-2.5 text-[var(--ink-soft)] italic">Hecho con código y café.</p>
          </div>
        </div>

        <div class="win rise">
          <div class="win-bar is-ink">
            <span class="scramble">STACK.LOG</span>
            <span class="win-btns"><i></i><i></i><i></i></span>
          </div>
          <ul class="p-3 text-[11.5px] leading-relaxed space-y-1">
            {stack.map((s) => <li>&gt; {s}</li>)}
          </ul>
        </div>
      </div>

      <!-- Carrusel de logos de lenguajes / tecnologías -->
      <div class="logoloop" role="region" aria-label="Lenguajes y tecnologías">
        <div class="logoloop__track">
          {
            [...techLogos, ...techLogos].map((l, i) => (
              <span class="logoloop__item" title={l.title || l.text} aria-hidden={i >= techLogos.length ? 'true' : undefined}>
                {l.slug ? (
                  <img
                    src={`https://cdn.simpleicons.org/${l.slug}`}
                    alt={l.title}
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                    width="40"
                    height="40"
                  />
                ) : (
                  <span class="logoloop__chip">{l.text}</span>
                )}
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ═══════════ 3 · CONTACTO ═══════════ -->
    <section class="space-y-4">
      <div class="section-label">// Contacto</div>
      <div class="grid gap-3 sm:grid-cols-2">
        {
          profile.links.map((link) => {
            const cfg = linkConfig[link.label] || { bar: 'background:#17141f', path: null };
            const handle =
              link.label === 'Discord'
                ? 'Yokonad'
                : link.url.replace('mailto:', '').replace('https://', '').replace('www.', '');
            return (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-4 border-2 border-[var(--ink)] bg-[var(--panel)] p-3.5 transition-all duration-150 hover:-translate-y-0.5 hover:shadow-[5px_5px_0_rgba(244,244,245,0.3)]"
              >
                <span
                  class="flex items-center justify-center w-12 h-12 shrink-0 border-2 border-[var(--ink)] text-[var(--cream)] transition-transform duration-150 group-hover:scale-105"
                  style={cfg.bar}
                >
                  {cfg.path && (
                    <svg viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                      <path d={cfg.path} />
                    </svg>
                  )}
                </span>
                <span class="flex-1 min-w-0">
                  <span class="block text-[13px] font-bold uppercase tracking-[0.18em]">{link.label}</span>
                  <span class="block text-[11.5px] text-[var(--ink-soft)] truncate">{handle}</span>
                </span>
              </a>
            );
          })
        }
      </div>
    </section>

    <!-- ═══════════ 4 · ACTIVIDAD · GITHUB ═══════════ -->
    <section class="space-y-4">
      <div class="section-label">// Actividad · GitHub</div>
      <div class="grid gap-3 md:grid-cols-[4fr_1fr]">
        <div class="win rise">
          <div class="win-bar is-ink">
            <span class="scramble">GITHUB.ACTIVITY</span>
            <span class="win-btns"><i></i><i></i><i></i></span>
          </div>
          <div class="p-3">
            <div class="flex items-center justify-between mb-2">
              <a href="https://github.com/Yokonad" target="_blank" rel="noopener noreferrer" class="text-[11px] font-bold uppercase tracking-widest">yokonad</a>
              <span id="gh-total" class="text-[10px] text-[var(--ink-soft)]">…</span>
            </div>
            <div id="gh-cal" class="overflow-x-auto pb-1">
              <div class="text-[11px] text-[var(--ink-soft)] py-6 text-center">Cargando contribuciones…</div>
            </div>
            <div class="flex items-center justify-end gap-1 mt-2 text-[9px] text-[var(--ink-soft)]">
              <span class="mr-1">Menos</span>
              <span class="gh-cell" style="background:rgba(244,244,245,0.10)"></span>
              <span class="gh-cell" style="background:#9be9a8"></span>
              <span class="gh-cell" style="background:#40c463"></span>
              <span class="gh-cell" style="background:#30a14e"></span>
              <span class="gh-cell" style="background:#216e39"></span>
              <span class="ml-1">Más</span>
            </div>
          </div>
        </div>

        <div class="win rise overflow-hidden hidden md:block relative">
          <img
            src="https://media.tenor.com/P3SQJ4JbHOsAAAAd/tying-the-knot-with-an-amagami-sister-%E7%94%98%E7%A5%9E%E3%81%95%E3%82%93%E3%81%A1%E3%81%AE%E7%B8%81%E7%B5%90%E3%81%B3.gif"
            alt="Amagami-san Chi no Enmusubi"
            loading="lazy"
            class="absolute inset-0 w-full h-full object-cover"
          />
        </div>
      </div>
    </section>

    <!-- ═══════════ 5 · INFORMACIÓN ═══════════ -->
    <section class="space-y-4">
      <div class="section-label">// Información</div>
      <div class="grid gap-3 md:grid-cols-3">
        <!-- Ciberataques -->
        <div class="win rise flex flex-col">
          <div class="win-bar" style="background:#c0392b">
            <span class="scramble">THREAT.LIVE</span>
            <span class="win-btns"><i></i><i></i><i></i></span>
          </div>
          <div class="p-4 flex-1 flex flex-col items-center justify-center text-center min-h-[120px]">
            <span class="text-[9px] uppercase tracking-widest mb-2">Ataques a sitios web (2026)</span>
            <span id="cyber-count" class="text-xl sm:text-2xl font-bold tabular-nums" style="color:#c0392b">0</span>
            <span class="text-[8px] mt-1.5 text-[var(--ink-soft)]">~2,200/seg · Cybersecurity Ventures</span>
          </div>
        </div>

        <!-- Go-Tōbun -->
        <div class="win rise flex flex-col">
          <div class="win-bar" style="background:linear-gradient(135deg,#E8845C,#EB7B94,#5DBAE0,#F3C553,#59C196)">
            <span class="scramble">MANGA.HIATUS</span>
            <span class="win-btns"><i></i><i></i><i></i></span>
          </div>
          <div class="p-4 flex-1 flex flex-col items-center justify-center text-center min-h-[120px]">
            <span class="text-[9px] uppercase tracking-widest mb-1">Sin nuevo capítulo de</span>
            <span class="text-[11px] font-bold mb-1.5">Go-Tōbun no Hanayome</span>
            <div id="quint" class="flex flex-wrap justify-center items-end gap-1 text-[var(--violet-deep)]">…</div>
            <span class="text-[8px] mt-1.5 text-[var(--ink-soft)]">Cap. #122 — 19 Feb 2020</span>
          </div>
        </div>

        <!-- Barça -->
        <div class="win rise flex flex-col">
          <div class="win-bar" style="background:#4d6bf2">
            <span class="scramble">FUTBOL.LOG</span>
            <span class="win-btns"><i></i><i></i><i></i></span>
          </div>
          <div id="barca" class="p-4 flex-1 flex flex-col items-center justify-center text-center min-h-[120px]">
            <span class="text-[11px] text-[var(--ink-soft)]">Cargando…</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ 6 · COMUNIDADES ═══════════ -->
    <section class="space-y-4">
      <div class="section-label">// Comunidades</div>
      <div class="grid gap-3 md:grid-cols-2">
        <!-- KoroSoft Community -->
        <div class="win rise overflow-hidden flex flex-col">
          <div class="win-bar" style="background:var(--korosoft)"><span class="scramble">KoroSoft Community</span><span class="win-btns"><i></i><i></i><i></i></span></div>
          <div class="w-full h-40 flex items-center justify-center gap-3 sm:gap-4 border-b-2 border-[var(--ink)] p-4" style="background:linear-gradient(135deg,#2a1a6b,#6b4fd6)">
            <img src="/picture/linux-svgrepo-com.webp" alt="Tux" loading="lazy" class="w-16 h-16 sm:w-20 sm:h-20 shrink-0 object-contain" />
            <span class="display text-3xl sm:text-4xl uppercase tracking-wider text-white" style="text-shadow:2px 2px 0 rgba(0,0,0,0.4)">KoroSoft</span>
          </div>
