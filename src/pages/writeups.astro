---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import HtbTerminal from '../components/HtbTerminal.jsx';

const diffColor = {
  Easy: { c: '#9fef00', bg: 'rgba(159,239,0,0.14)' },
  Medium: { c: '#ffb83e', bg: 'rgba(255,184,62,0.14)' },
  Hard: { c: '#ff3e3e', bg: 'rgba(255,62,62,0.14)' },
  Insane: { c: '#ff54c7', bg: 'rgba(255,84,199,0.14)' },
};
const osColor = { Linux: '#f5b400', Windows: '#4d9fff', Otro: '#9a9aa3' };
const NAVY = '#131c2b';

let entries = await getCollection('writeups');
entries = entries.sort((a, b) => (a.data.date < b.data.date ? 1 : -1));
const total = entries.length;
---

<Layout
  title="Write-ups | yokonad"
  description="Write-ups de Hack The Box de Yokonad: máquinas y retos resueltos paso a paso — reconocimiento, explotación y escalada de privilegios."
  path="/writeups/"
>
  <div class="codex-edges codex-stack w-full py-4 sm:py-6">
    <!-- ═══════════ MASTHEAD ═══════════ -->
    <header class="flex items-center justify-between border-2 border-[var(--ink)] px-3 py-2" style={`background:${NAVY};color:var(--cream)`}>
      <a href="/" class="inline-flex items-center gap-1.5 text-[9px] sm:text-[12px] font-bold tracking-[0.14em] uppercase hover:brightness-125" style="color:var(--cream)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg>
        Volver
      </a>
      <span class="text-[9px] sm:text-[12px] font-bold tracking-[0.14em] uppercase flex items-center gap-2 sm:gap-3">
        <span>WRITE-UPS // <span style="color:#9fef00">HTB</span></span>
        <span class="win-btns"><i></i><i></i><i></i></span>
      </span>
    </header>

    <!-- ═══════════ HERO ═══════════ -->
    <section class="flex items-center gap-4">
      <svg viewBox="0 0 100 100" class="w-12 h-12 sm:w-16 sm:h-16 shrink-0" fill="none" stroke="#9fef00" stroke-width="5" stroke-linejoin="round" aria-hidden="true">
        <path d="M50 5 L89 27.5 L89 72.5 L50 95 L11 72.5 L11 27.5 Z" />
        <path d="M50 50 L50 95 M50 50 L89 27.5 M50 50 L11 27.5" stroke-width="4" />
      </svg>
      <div class="min-w-0">
        <h1 class="display uppercase leading-[0.85] text-[clamp(1.9rem,7vw,3.4rem)]" style="color:#9fef00;text-shadow:3px 3px 0 rgba(159,239,0,0.16)">Write-ups</h1>
        <p class="mt-1.5 text-[11px] sm:text-[12px] text-[var(--ink-soft)]">Hack The Box · {total} publicados</p>
      </div>
    </section>

    <!-- ═══════════ TERMINAL: conectar la VPN ═══════════ -->
    <HtbTerminal client:load />

    <!-- ═══════════ CUADROS ═══════════ -->
    <section class="space-y-4">
      <div class="section-label" style={`background:${NAVY};color:var(--cream);border-color:var(--ink)`}>// Índice · {total}</div>

      {total === 0 ? (
        <p class="text-[13px] text-[var(--ink-soft)]">Aún no hay write-ups. Añade archivos <code>.md</code> en <code>src/content/writeups/</code>.</p>
      ) : (
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {entries.map((e) => {
            const d = diffColor[e.data.difficulty] || diffColor.Easy;
            return (
              <a href={`/writeups/${e.id}`} class="win flex flex-col">
                <div class="win-bar" style={`background:${NAVY};color:var(--cream)`}>
                  <span class="truncate">{e.data.title}</span>
                  <span class="win-btns"><i></i><i></i><i></i></span>
                </div>
                <div class="p-3 flex-1 flex flex-col gap-2.5">
                  <div class="flex items-center gap-2.5">
                    <span class="wu-mach">
                      {e.data.icon ? (
                        <img src={e.data.icon} alt="" loading="lazy" />
                      ) : (
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#3f5168" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H4z" /><path d="M9 20h6M12 16v4" /></svg>
                      )}
                    </span>
                    <div class="flex items-center gap-1.5 flex-wrap">
                      <span class="px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide border" style={`border-color:${d.c};color:${d.c};background:${d.bg}`}>{e.data.difficulty}</span>
                      <span class="px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide border" style={`border-color:${osColor[e.data.os] || '#9a9aa3'};color:${osColor[e.data.os] || '#9a9aa3'}`}>{e.data.os}</span>
                    </div>
                  </div>
                  <p class="text-[11.5px] leading-snug text-[var(--ink-soft)] flex-1">{e.data.summary}</p>
                  {e.data.tags && e.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1.5">
                      {e.data.tags.map((t) => (
                        <span class="px-1.5 py-0.5 text-[8.5px] uppercase tracking-wide border border-[rgba(255,255,255,0.22)] text-[var(--ink-soft)]">{t}</span>
                      ))}
                    </div>
                  )}
                  <div class="flex items-center justify-between mt-1 pt-2 border-t border-dashed border-[rgba(244,244,245,0.18)]">
                    <span class="text-[10px] text-[var(--ink-soft)]">{e.data.date}</span>
                    <span class="text-[11px] font-bold">Leer →</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </section>

    <!-- ═══════════ BARRA INFERIOR ═══════════ -->
    <footer class="flex items-center border-2 border-[var(--ink)] px-3 py-2.5" style={`background:${NAVY};color:var(--cream)`}>
      <span class="text-[9px] sm:text-[12px] font-bold tracking-[0.12em] uppercase">HACK THE BOX · WRITE-UPS</span>
    </footer>
  </div>
</Layout>
